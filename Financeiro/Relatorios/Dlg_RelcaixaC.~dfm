      '       x.numcheque,'
      '       1 as TipoOperacao,'
      '       0,'
      '       cast('#39#39' as varchar(15))'
      'from transacoes x'
      '        left join Favorecidos f on f.favorecido = x.favorecido'
      'where x.situacao = '#39'R'#39
      'and x.tipotransacao = '#39'C'#39
      'and x.conta = :conta'
