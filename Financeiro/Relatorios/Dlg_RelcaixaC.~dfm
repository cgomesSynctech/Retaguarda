    SQL.Strings = (
      'Select f.nome,'
      '       dd.Valor,'
      '       d.historico,'
      '       dd.numcheque,'
      '       1 as TipoOperacao,'
      
        '       (select Max(dt.deposito) from depositostitulos dt inner j' +
        'oin titulosareceber a on (a.id = dt.titulo) and (a.empresa = dt.' +
        'empresa) and (a.pdv = dt.pdv)'
      
        '               where dt.deposito = dd.deposito and dt.data = :da' +
        'ta ) as IDGerador,'
      
        '       (select Max(a.titulo) from depositostitulos dt inner join' +
        ' titulosareceber a on (a.id = dt.titulo) and (a.empresa = dt.emp' +
        'resa) and (a.pdv = dt.pdv)'
      
        '               where dt.deposito = dd.deposito and  dt.data = :d' +
        'ata ) as Titulo'
      'From Depositos d'
      
        '        left join DepositosDoc dd on (d.deposito = dd.deposito) ' +
        'and (d.empresa = dd.empresa) and (d.pdv = dd.pdv)'
      '        left join Favorecidos f on d.favorecido = f.favorecido'
      
        '        left join FormasPagamento fp on dd.formapagamento = fp.f' +
        'ormapagamento'
      '        left join TiposOrigens t on d.tipodeposito = t.origem'
      '        left join Contas c on d.Conta = c.Conta'
      'Where  dd.formapagamento = :formapagamento '
      'and (d.situacao = '#39'N'#39')'
      'and d.data = :data '
      'and d.conta = :Conta'
      ''
      'union'
      ''
      'select f.nome,'
