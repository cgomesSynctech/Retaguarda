  object Q_Invoice: TIBQuery
    Database = DMProjeto.DB_Projeto
    Transaction = DMProjeto.IBT_Projeto
    BufferChunks = 1000
    CachedUpdates = False
    SQL.Strings = (
      'Select   tm.cb_notaentrega, s.saida, s.empresa, s.pdv, '
      
        '             abs(( s.desconto / s.totalitens ) * 100) as percent' +
        'ualdesconto,'
      '             s.numero as invoice, '
      '             s.data, '
      '             s.total,  '
      '             s.TotalPgtos,'
      '             s.situacao,'
      '             s.dataentrega, '
      
        '             case when fe.enderecoentrega is null then f.enderec' +
        'o else fe.enderecoentrega end as enderecoentrega, '
      '             s.desconto,'
      '             s.frete,'
      '             s.outrasdespesas,'
      '             s.juros,'
      '             s.validade, '
      '             s.impresso,'
      '             s.totalitens,'
      '             s.Status,'
      '             s.cfopnota,'
      '             s.serienota,'
      '             s.ufdestino,'
      '             s.basecalcicms,'
      '             s.valoricms,'
      '             s.valoriss,'
      '             s.valoripi,'
      '             s.basecalcsubst,'
      '             s.valoricmssubst, '
      '             s.valorseguro,'
      '             s.tipofrete,'
      '             s.pesobruto,'
      '             s.pesoliquido,'
      '             s.aliqicmsvenda,'
      '             s.valorisentas,'
      '             s.totalservicos,'
      '             s.descespecie,'
      '             s.descmarca,'
      '             s.descnumero,'
      '             s.possuiicms,'
      '             s.possuiiss,'
      '             s.contabilizaicms,'
      '             s.modelo,'
      '             s.valoroutrasicms,'
      '             s.valorisentasipi,'
      '             s.valoroutrasipi,'
      '             s.baseincluso,'
      '             s.volumes,'
      '             s.fonte,'
      '             s.placaveic,'
      '             s.atratar,'
      '             s.introducao,'
      '             s.prazoentrega,'
      '             s.condicoespgto,'
      '             s.condicoespagto,'
      '             s.garantia,'
      '             s.seestoque,'
      '             s.processo,'
      '             s.cartaconvite,'
      '             s.tomadaprecos,'
      '             s.dataabertura,'
      '             s.explicacoes,'
      '             s.licitacaoicms,'
      '             s.substtrib,'
      '             s.pjurosnegociado,'
      '             s.NF_Cupom,'
      '             s.MensagemItem,'
      
        '             SubString(fe.bairroentrega || '#39' '#39' || fe.cidadeentre' +
        'ga || '#39' - '#39' || fe.ufentrega || '#39' '#39' || fe.cepentrega from 1 for 5' +
        '0) as cidadeufzipentrega,'
      '             te.descricao as tipoentrega,'
      '             v.nome as vendedor,'
      '             v.rg,'
      '             v.codigo as codigovendedor,'
      '             s.PEDIDO_CLIENTE,'
      '             s.campo01, s.campo02, s.campo03, s.campo04,'
      '             pp.descricao as planopag,'
      
        '             coalesce(s.obs,'#39#39') || (select decreto from PP_DECRE' +
        'TO_TRIBUTACAO(:saida))|| (select decreto from PP_MENSAGEMITENS(:' +
        'saida)) as obs,'
      '             s.totalprodutos,'
      '             f.cpf_cnpj,'
      '             f.codigo as codigocliente,'
      '             f.inscricao_est,'
      '             f.nome, '
      '             f.razao,'
      '             f.endereco,'
      
        '             SubString(f.bairro || '#39' '#39' || f.cidade || '#39' - '#39' || f' +
        '.uf || '#39' '#39' || f.cep from 1 for 50) as cidadeufzip,'
      '             f.bairro, f.cidade, f.cep,'
      '             f.fone1, f.fax, f.uf, f.NRO,'
      '             tm.*,'
      '             s.termocontrato as DescTermoContrato,'
      '             tc.Titulo as TituloContrato,'
      '             tp.Arquivo as TemplateArquivo,'
      '             tpnf.Arquivo as TemplateNFArquivo,'
      '             ss.Descricao as DescStatusSaida,'
      '             t.tipoorigem,'
      '             s.Total - s.TotalPgtos as Balance,'
      '             cf.descricao as desc_cfop,'
      '             transp.nome as transp_nome,'
      '             transp.endereco as transp_endereco,'
      '             transp.bairro as transp_bairro,'
      '             transp.cidade as transp_cidade,'
      '             transp.uf as transp_uf,'
      '             transp.cpf_cnpj as transp_cpf_cnpj,'
      '             transp.inscricao_est as transp_inscricao_est,'
      '             cg.descricao as cargovendedor,'
      '             x.descricao as TipoCobranca,'
      '             f.obs as obscliente, '
      '             f.email,'
      '             f.celular,'
      
        '             cc.reffone, cc.refnome, cc.refnome2, cc.reffone2, c' +
        'c.refnome3, cc.reffone3'
      'From Saidas s'
      'Left Join Favorecidos f On s.favorecido=f.favorecido'
      'Left Join TiposMovimento tm On s.tipomovimento=tm.tipomovimento'
      'Left Join Favorecidosentrega fe On s.localentrega=fe.entrega'
      
        'Left Join PlanosPagamento pp On s.planopagamento=pp.planopagamen' +
        'to'
      'Left Join Favorecidos v On s.vendedor=v.favorecido'
      'Left Join Cargos cg on v.cargo = cg.cargo'
      'Left Join TiposEntrega te On s.tipoentrega=te.tipoentrega'
      
        'Left Join TermosContratos tc On tc.termocontrato=tm.termocontrat' +
        'o'
      'Left Join Templates tp on tm.template = tp.template'
      
        'Left Join Templates tpnf on tm.templatenotafiscal = tpnf.templat' +
        'e'
      'Left Join StatusSaidas ss on ss.status = s.status'
      'Left Join TiposPadrao t on t.tipopadrao = s.tipopadrao'
      'Left Join CFOPS cf on cf.cfop = s.cfopnota'
      
        'Left Join Favorecidos transp on transp.favorecido = s.transporta' +
        'dora'
      'Left Join TiposCobranca x on x.tipocobranca = s.cobranca'
      'Left Join clientes cc on cc.favorecido = f.favorecido'
      
        'Where s.saida =:saida and s.empresa = :empresa and s.pdv = :pdv ' +
        ' ')
    Left = 445
    Top = 89
    ParamData = <
      item
        DataType = ftInteger
        Name = 'saida'
        ParamType = ptInput
        Value = '15223'
      end
      item
