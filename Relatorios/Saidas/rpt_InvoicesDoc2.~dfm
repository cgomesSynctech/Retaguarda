    DataSource = Q_InvoiceDS
    SQL.Strings = (
      
        'Select tr.parcela, tr.valor, tr.vencimento, tr.venda, tr.empresa' +
        ', tr.pdv, tr.status, tr.titulo, tr.valor as ValorPago,'
      '--, f.sigla'
      'case when tr.status = 50 then '#39'PG'#39' else '#39' '#39' end as sigla'
      'From TitulosAReceber tr'
      '  left join depositostitulos dt on dt.titulo = tr.id'
      '  --left join depositos d on d.deposito = dt.deposito'
      '  --left join depositosdoc dd on d.deposito = dd.deposito'
      
